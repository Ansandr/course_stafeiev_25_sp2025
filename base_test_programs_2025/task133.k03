/* Завдання 133 */
/* Обчислити суму елементів що стоять на парних індексах */
/* в двійковому це число яке має 0 на початку */

program AA0;
start var int32 MA0[100], SU1, ID2, CN4;

/* Присвоєення значень масиву
read CN4;

0 :> ID2; /* індекс */
while ID2 lt CN4 {
    read MA0[ID2];
    ID2 add 1 :> ID2;
}

0 :> SU1; /* сума */
0 :> ID2; /* індекс */

/* Цикл для обчислення суми елементів на парних індексах */
while ID2 lt CN4 {
    if ID2 % 2 == 0 {
        SU1 add MA0[ID2] :> SU1;
    };
    ID2 add 1 :> ID2;
}

write SU1;

end