@startuml
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontColor black
skinparam ConditionEndStyle hline
skinparam ArrowColor black

start

:Створити порожній стек операторів;
:Створити вихідну чергу для RPN;

while (Є лексеми для обробки?) is (Так)
  :Отримати поточну лексему;
  
  if (Лексема є операндом?) then (Так)
    :Додати операнд до вихідної черги;
    
    if (Ідентифікатор у контексті\nприсвоєння/введення/індексації?) then (Так)
      :Перетворити на адресу в пам'яті;
    endif
    
  elseif (Лексема є оператором?) then (Так)
    
    while (Стек не порожній\nАБО вершина стека - оператор?) is (Так)
      :Отримати оператор з вершини стека;
      
      if (Пріоритет вищий ніж у поточного?) then (Так)
        :Виштовхнути оператор\nзі стека до вихідної черги;
      elseif (Пріоритет однаковий\nАБО поточний лівоасоціативний?) then (Так)
        :Виштовхнути оператор\nзі стека до вихідної черги;
      else (Ні)
        break
      endif
    endwhile (Ні)
    
    :Покласти поточний оператор на стек;
    
  elseif (Лексема є лівою дужкою?) then (Так)
    :Покласти ліву дужку на стек;
    
  elseif (Лексема є правою дужкою?) then (Так)
    
    while (Вершина стека не ліва дужка?) is (Так)
      :Виштовхнути оператор\nзі стека до вихідної черги;
    endwhile (Ні)
    
    :Видалити ліву дужку зі стека;
  endif
  
endwhile (Ні)

:Виштовхнути всі оператори\nзі стека до вихідної черги;

:Повернути RPN-послідовність;

stop

@enduml
