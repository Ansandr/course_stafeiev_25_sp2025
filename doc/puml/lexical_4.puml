@startuml
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontColor black
skinparam ConditionEndStyle hline
skinparam ArrowColor black

start

:Вхід: DFA;

:k = 0;
:Розбити стани на два класи\n(0-еквівалентність);
note right
  Клас 1: заключні стани (F)
  Клас 2: незаключні стани (Q\F)
end note

repeat
  :k = k + 1;
  :Створити порожнє розбиття для k-еквівалентності;
  
  while (Для кожного класу (k-1)-еквівалентності) is (Є класи)
    :Взяти клас еквівалентності C;
    
    while (Для кожної пари станів q₁, q₂ у C) is (Є пари)
      :Припустити, що q₁ =ᵏ q₂;
      
      while (Для кожного символу a алфавіту) is (Є символи)
        :Обчислити δ(q₁, a) та δ(q₂, a);
        
        if (δ(q₁, a) та δ(q₂, a)\nналежать різним класам (k-1)-еквівалентності?) then (Так)
          :q₁ ≠ᵏ q₂;
          :Розділити q₁ та q₂\nна різні класи k-еквівалентності;
          break
        endif
      endwhile (Ні)
      
      if (Для всіх символів\nδ(q₁, a) та δ(q₂, a) у одному класі?) then (Так)
        :q₁ =ᵏ q₂;
        :Залишити q₁ та q₂\nу одному класі k-еквівалентності;
      endif
    endwhile (Ні)
  endwhile (Ні)
  
repeat while (Розбиття змінилось?) is (Так)
->Ні;

:Побудова мінімального автомата M';

:Для кожного класу еквівалентності\nстворити узагальнений стан [qₙ];
note right
  Q' = {[q₁], [q₂], ..., [qₙ]}
end note

:Початковий стан I' = [q₀];
note right
  Узагальнений стан,
  що містить початкові стани M
end note

while (Для кожного узагальненого стану [qₙ]) is (Є стани)
  while (Для кожного символу a) is (Є символи)
    :Обчислити δ([qₙ], a);
    note right
      Знайти узагальнений стан,
      до якого належать δ(q, a)
      для q ∈ [qₙ]
    end note
    
    :Додати перехід ([qₙ], a, [δ([qₙ], a)])\nдо δ';
  endwhile (Ні)
endwhile (Ні)

:Визначити заключні стани F';
note right
  Узагальнений стан є заключним,
  якщо хоча б один стан його класу
  є заключним у M
end note

:Видалити недосяжні стани;
note right
  Виклик removing_unreachable_DFA_states()
  для видалення мертвих станів
end note

:Повернути мінімальний DFA M';

stop

@enduml
