@startuml
skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontColor black
skinparam ConditionEndStyle hline
skinparam ArrowColor black

start

:Вхід: регулярний вираз;

if (Регулярний вираз є символом 'a'?) then (Так)
  :Створити автомат з двох станів;
  :З'єднати дугою з міткою 'a'/
  stop
endif

if (Регулярний вираз є порожнім словом ε?) then (Так)
  :Створити автомат з переходом по ε-дузі/
  stop
endif

if (Регулярний вираз є порожньою множиною ∅?) then (Так)
  :Створити автомат без переходів/
  stop
endif

if (Операція об'єднання e + f?) then (Так)
  :Побудувати автомати M₁ та M₂\nдля e та f рекурсивно|
  :Ввести новий початковий стан s₀;
  :Ввести новий заключний стан t;
  :Провести ε-переходи з s₀\nдо початкових станів M₁ та M₂;
  :Провести ε-переходи з заключних\nстанів M₁ та M₂ до t;
  stop
endif

if (Операція конкатенації e · f?) then (Так)
  :Побудувати автомати M₁ та M₂\nдля e та f рекурсивно|
  :Зберегти всі дуги і вершини M₁ та M₂;
  :Початковий стан M₁ стає початковим;
  :Заключні стани M₂ стають заключними;
  :З'єднати заключні стани M₁\nз початковим станом M₂ ε-дугами;
  stop
endif

if (Операція ітерації e*?) then (Так)
  :Побудувати автомат M для e рекурсивно|
  :Ввести новий початковий стан s₀;
  :Ввести новий заключний стан t;
  :Провести ε-дугу з s₀ до t;
  :Провести ε-дуги з s₀ до\nпочаткового стану M;
  :Провести ε-дуги з заключних\nстанів M назад до початкового стану M;
  :Провести ε-дуги з заключних\nстанів M до t;
  stop
endif

:Повернути побудований NFA;

stop

@enduml
