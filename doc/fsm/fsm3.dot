digraph FSM_IDENTIFIERS {
  // === 1. A4 Layout & Top Legend ===
  size="7.5,10"; 
  ratio="compress"; 
  dpi=72; 
  margin=0; 
  rankdir=LR;

  labelloc="t"; // Легенда зверху
  labeljust="l";

  // HTML-легенда
  label=<
    <table border="0" cellborder="0" cellspacing="0" cellpadding="0">
      <tr><td>
        <table border="0" cellborder="1" cellspacing="0" cellpadding="8" bgcolor="#f5f5f5">
          <tr><td border="0"><b><font point-size="14">FSM: Identifiers</font></b></td></tr>
          <tr><td border="0">
            <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white">
              <tr><td bgcolor="#dddddd"><b>Тег</b></td><td bgcolor="#dddddd"><b>Значення</b></td></tr>
              <tr><td>[A-Z]</td><td>Великі латинські літери</td></tr>
              <tr><td>[0-9]</td><td>Цифри</td></tr>
            </table>
          </td></tr>
        </table>
      </td></tr>
      <tr><td height="20"></td></tr>
    </table>
  >;

  // === 2. Geometry & Type ===
  splines=true; overlap=false; nodesep=0.5; ranksep=0.8;
  node [fontname="Helvetica", fontsize=10, shape=circle];
  edge [fontname="Helvetica", fontsize=9];

  // === 3. Nodes ===
  start [shape=point];
  
  // Фінальний стан
  node [shape=doublecircle, style=filled, fillcolor="#e8e8e8"]; q3;

  // Звичайні стани
  node [shape=circle, style=solid, fillcolor="white"];
  q0; q1; q2;

  // === 4. Edges ===
  start -> q0;

  // Логіка: 2 літери -> цифра
  q0 -> q1 [label="[A-Z]"];
  q1 -> q2 [label="[A-Z]"];
  q2 -> q3 [label="[0-9]"];
}